## expr line 2
func action(c Act) (Datum, Fail) {
  let tf1 = action.read([$lhs])
  let tf2 = action.read([$then])
  let tf3 = action.read([$rhs])
  let tn4 = action.struct([Conditional])
  let tfirst5 = true
  action.setField([Cond], tn4, tf1)
  tfirst5 = cover(tn4, tf1, tfirst5)
  action.setField([Then], tn4, tf2)
  tfirst5 = cover(tn4, tf2, tfirst5)
  action.setField([Else], tn4, tf3)
  tfirst5 = cover(tn4, tf3, tfirst5)
  made(c, tn4, tfirst5)
  return action.fromObj(tn4), null(Fail)
}

