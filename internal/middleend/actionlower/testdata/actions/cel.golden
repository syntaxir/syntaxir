## not_unary action
func action(c Act) (Datum, Fail) {
  let ti1, tf1 = items(action.name([foldr]), action.read([$ops]))
  if (tf1 != null(Fail)) {
    return null(Datum), tf1
  }
  let ta2 = action.read([$m])
  let tj3 = 0
  loop each4 while (tj3 < seq.len(ti1)); post tj3 = (tj3 + 1) {
    let tp5 = ta2
    let tp6 = itemAt(ti1, tj3, true)
    let tv7, tf7 = member(c, 4, val.unbox(tp6), action.name([$o]), action.field([o of $o]))
    if (tf7 != null(Fail)) {
      return null(Datum), tf7
    }
    let tf8 = val.unbox(tp5)
    let tn9 = action.struct([Unary])
    let tfirst10 = true
    action.setField([Op], tn9, tv7)
    tfirst10 = cover(tn9, tv7, tfirst10)
    action.setField([X], tn9, tf8)
    tfirst10 = cover(tn9, tf8, tfirst10)
    made(c, tn9, tfirst10)
    let tv11 = action.fromObj(tn9)
    ta2 = tv11
  }
  return ta2, null(Fail)
}

