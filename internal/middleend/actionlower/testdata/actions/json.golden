## main action
func action(c Act) (Datum, Fail) {
  return action.read([$v]), null(Fail)
}

## object action
func action(c Act) (Datum, Fail) {
  let tm1 = action.kids()
  let tf2 = pushItems(c, action.name([concat]), action.read([$ms]))
  if (tf2 != null(Fail)) {
    return null(Datum), tf2
  }
  let tk3 = action.elemsAbove(tm1)
  let tn4 = hull(c, false, tk3)
  let tf5 = action.fromObj(tn4)
  let tn6 = action.struct([Object])
  let tfirst7 = true
  action.setField([Members], tn6, tf5)
  tfirst7 = cover(tn6, tf5, tfirst7)
  made(c, tn6, tfirst7)
  return action.fromObj(tn6), null(Fail)
}

## members action
func action(c Act) (Datum, Fail) {
  let tm1 = action.kids()
  let tf2 = push(c, action.name([list]), action.read([$first]))
  if (tf2 != null(Fail)) {
    return null(Datum), tf2
  }
  let ti3, tf3 = items(action.name([map]), action.read([$rest]))
  if (tf3 != null(Fail)) {
    return null(Datum), tf3
  }
  let tj4 = 0
  loop each5 while (tj4 < seq.len(ti3)); post tj4 = (tj4 + 1) {
    let tp6 = itemAt(ti3, tj4, false)
    let tv7, tf7 = member(c, 4, val.unbox(tp6), action.name([$m]), action.field([m of $m]))
    if (tf7 != null(Fail)) {
      return null(Datum), tf7
    }
    let tv8 = tv7
    let tf9 = push(c, action.name([map]), tv8)
    if (tf9 != null(Fail)) {
      return null(Datum), tf9
    }
  }
  let tk10 = action.elemsAbove(tm1)
  let tn11 = hull(c, false, tk10)
  return action.fromObj(tn11), null(Fail)
}

## member action
func action(c Act) (Datum, Fail) {
  let tf1 = action.read([$k])
  let tf2 = action.read([$v])
  let tn3 = action.struct([Member])
  let tfirst4 = true
  action.setField([Key], tn3, tf1)
  tfirst4 = cover(tn3, tf1, tfirst4)
  action.setField([Value], tn3, tf2)
  tfirst4 = cover(tn3, tf2, tfirst4)
  made(c, tn3, tfirst4)
  return action.fromObj(tn3), null(Fail)
}

## array action
func action(c Act) (Datum, Fail) {
  let tm1 = action.kids()
  let tf2 = pushItems(c, action.name([concat]), action.read([$es]))
  if (tf2 != null(Fail)) {
    return null(Datum), tf2
  }
  let tk3 = action.elemsAbove(tm1)
  let tn4 = hull(c, false, tk3)
  let tf5 = action.fromObj(tn4)
  let tn6 = action.struct([Array])
  let tfirst7 = true
  action.setField([Elements], tn6, tf5)
  tfirst7 = cover(tn6, tf5, tfirst7)
  made(c, tn6, tfirst7)
  return action.fromObj(tn6), null(Fail)
}

## elements action
func action(c Act) (Datum, Fail) {
  let tm1 = action.kids()
  let tf2 = push(c, action.name([list]), action.read([$first]))
  if (tf2 != null(Fail)) {
    return null(Datum), tf2
  }
  let ti3, tf3 = items(action.name([map]), action.read([$rest]))
  if (tf3 != null(Fail)) {
    return null(Datum), tf3
  }
  let tj4 = 0
  loop each5 while (tj4 < seq.len(ti3)); post tj4 = (tj4 + 1) {
    let tp6 = itemAt(ti3, tj4, false)
    let tv7, tf7 = member(c, 4, val.unbox(tp6), action.name([$v]), action.field([v of $v]))
    if (tf7 != null(Fail)) {
      return null(Datum), tf7
    }
    let tv8 = tv7
    let tf9 = push(c, action.name([map]), tv8)
    if (tf9 != null(Fail)) {
      return null(Datum), tf9
    }
  }
  let tk10 = action.elemsAbove(tm1)
  let tn11 = hull(c, false, tk10)
  return action.fromObj(tn11), null(Fail)
}

## string action
func action(c Act) (Datum, Fail) {
  return action.read([$s]), null(Fail)
}

