## pi predicate
func action(c Act) (Datum, Fail) {
  let ts1, tf1 = text(action.read([$t]))
  if (tf1 != null(Fail)) {
    return null(Datum), tf1
  }
  let tv2, tf2 = binary(6, action.fromStr(ts1), action.const(["xml"]))
  if (tf2 != null(Fail)) {
    return null(Datum), tf2
  }
  let tb3, tf3 = logic(0, tv2)
  if (tf3 != null(Fail)) {
    return null(Datum), tf3
  }
  let tv4 = val.fromBool(false)
  if tb3 {
    let ts5, tf5 = text(action.read([$t]))
    if (tf5 != null(Fail)) {
      return null(Datum), tf5
    }
    let tv6, tf6 = binary(6, action.fromStr(ts5), action.const(["xmL"]))
    if (tf6 != null(Fail)) {
      return null(Datum), tf6
    }
    let tb7, tf7 = logic(0, tv6)
    if (tf7 != null(Fail)) {
      return null(Datum), tf7
    }
    tv4 = val.fromBool(tb7)
  }
  let tb8, tf8 = logic(0, tv4)
  if (tf8 != null(Fail)) {
    return null(Datum), tf8
  }
  let tv9 = val.fromBool(false)
  if tb8 {
    let ts10, tf10 = text(action.read([$t]))
    if (tf10 != null(Fail)) {
      return null(Datum), tf10
    }
    let tv11, tf11 = binary(6, action.fromStr(ts10), action.const(["xMl"]))
    if (tf11 != null(Fail)) {
      return null(Datum), tf11
    }
    let tb12, tf12 = logic(0, tv11)
    if (tf12 != null(Fail)) {
      return null(Datum), tf12
    }
    tv9 = val.fromBool(tb12)
  }
  let tb13, tf13 = logic(0, tv9)
  if (tf13 != null(Fail)) {
    return null(Datum), tf13
  }
  let tv14 = val.fromBool(false)
  if tb13 {
    let ts15, tf15 = text(action.read([$t]))
    if (tf15 != null(Fail)) {
      return null(Datum), tf15
    }
    let tv16, tf16 = binary(6, action.fromStr(ts15), action.const(["xML"]))
    if (tf16 != null(Fail)) {
      return null(Datum), tf16
    }
    let tb17, tf17 = logic(0, tv16)
    if (tf17 != null(Fail)) {
      return null(Datum), tf17
    }
    tv14 = val.fromBool(tb17)
  }
  let tb18, tf18 = logic(0, tv14)
  if (tf18 != null(Fail)) {
    return null(Datum), tf18
  }
  let tv19 = val.fromBool(false)
  if tb18 {
    let ts20, tf20 = text(action.read([$t]))
    if (tf20 != null(Fail)) {
      return null(Datum), tf20
    }
    let tv21, tf21 = binary(6, action.fromStr(ts20), action.const(["Xml"]))
    if (tf21 != null(Fail)) {
      return null(Datum), tf21
    }
    let tb22, tf22 = logic(0, tv21)
    if (tf22 != null(Fail)) {
      return null(Datum), tf22
    }
    tv19 = val.fromBool(tb22)
  }
  let tb23, tf23 = logic(0, tv19)
  if (tf23 != null(Fail)) {
    return null(Datum), tf23
  }
  let tv24 = val.fromBool(false)
  if tb23 {
    let ts25, tf25 = text(action.read([$t]))
    if (tf25 != null(Fail)) {
      return null(Datum), tf25
    }
    let tv26, tf26 = binary(6, action.fromStr(ts25), action.const(["XmL"]))
    if (tf26 != null(Fail)) {
      return null(Datum), tf26
    }
    let tb27, tf27 = logic(0, tv26)
    if (tf27 != null(Fail)) {
      return null(Datum), tf27
    }
    tv24 = val.fromBool(tb27)
  }
  let tb28, tf28 = logic(0, tv24)
  if (tf28 != null(Fail)) {
    return null(Datum), tf28
  }
  let tv29 = val.fromBool(false)
  if tb28 {
    let ts30, tf30 = text(action.read([$t]))
    if (tf30 != null(Fail)) {
      return null(Datum), tf30
    }
    let tv31, tf31 = binary(6, action.fromStr(ts30), action.const(["XMl"]))
    if (tf31 != null(Fail)) {
      return null(Datum), tf31
    }
    let tb32, tf32 = logic(0, tv31)
    if (tf32 != null(Fail)) {
      return null(Datum), tf32
    }
    tv29 = val.fromBool(tb32)
  }
  let tb33, tf33 = logic(0, tv29)
  if (tf33 != null(Fail)) {
    return null(Datum), tf33
