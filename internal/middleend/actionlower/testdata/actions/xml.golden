## main action
func action(c Act) (Datum, Fail) {
  let tf1 = action.read([$d])
  let tm2 = action.kids()
  seq.step()
  let tf3 = pushItems(c, action.name([concat]), action.read([$p1]))
  if (tf3 != null(Fail)) {
    return null(Datum), tf3
  }
  seq.step()
  let tf4 = pushItems(c, action.name([concat]), action.read([$p2]))
  if (tf4 != null(Fail)) {
    return null(Datum), tf4
  }
  let tk5 = action.elemsAbove(tm2)
  let tn6 = hull(c, false, tk5)
  let tf7 = action.fromObj(tn6)
  let tf8 = action.read([$dt])
  let tf9 = action.read([$r])
  let tf10 = action.read([$e])
  let tn11 = action.struct([Document])
  let tfirst12 = true
  seq.step()
  action.setField([Decl], tn11, tf1)
  tfirst12 = cover(tn11, tf1, tfirst12)
  seq.step()
  action.setField([Prolog], tn11, tf7)
  tfirst12 = cover(tn11, tf7, tfirst12)
  seq.step()
  action.setField([Doctype], tn11, tf8)
  tfirst12 = cover(tn11, tf8, tfirst12)
  seq.step()
  action.setField([Root], tn11, tf9)
  tfirst12 = cover(tn11, tf9, tfirst12)
  seq.step()
  action.setField([Epilog], tn11, tf10)
  tfirst12 = cover(tn11, tf10, tfirst12)
  made(c, tn11, tfirst12)
  return action.fromObj(tn11), null(Fail)
}

## misc_list action
func action(c Act) (Datum, Fail) {
  let tm1 = action.kids()
  let ti2, tf2 = items(action.name([map]), action.read([$ms]))
  if (tf2 != null(Fail)) {
    return null(Datum), tf2
  }
  let tj3 = 0
  loop each4 while (tj3 < seq.len(ti2)); post tj3 = (tj3 + 1) {
    seq.step()
    let tp5 = itemAt(ti2, tj3, false)
    let tv7, tf7 = member(c, 4, val.unbox(tp5), action.name([$m]), action.field([m of $m]))
    if (tf7 != null(Fail)) {
      return null(Datum), tf7
    }
    let tv6 = tv7
    let tf8 = push(c, action.name([map]), tv6)
    if (tf8 != null(Fail)) {
      return null(Datum), tf8
    }
  }
  let tk9 = action.elemsAbove(tm1)
  let tn10 = hull(c, false, tk9)
  return action.fromObj(tn10), null(Fail)
}

