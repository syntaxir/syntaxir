## element action
func action(c Act) (Datum, Fail) {
  let tf1 = action.read([$n])
  let tm2 = action.kids()
  let ti3, tf3 = items(action.name([map]), action.read([$as]))
  if (tf3 != null(Fail)) {
    return null(Datum), tf3
  }
  let tj4 = 0
  loop each5 while (tj4 < seq.len(ti3)); post tj4 = (tj4 + 1) {
    seq.step()
    let tp6 = itemAt(ti3, tj4, false)
    let tv8, tf8 = member(c, 4, val.unbox(tp6), action.name([$a]), action.field([a of $a]))
    if (tf8 != null(Fail)) {
      return null(Datum), tf8
    }
    let tv7 = tv8
    let tf9 = push(c, action.name([map]), tv7)
    if (tf9 != null(Fail)) {
      return null(Datum), tf9
    }
  }
  let tk10 = action.elemsAbove(tm2)
  let tn11 = hull(c, false, tk10)
  let tf12 = action.fromObj(tn11)
  let tm13 = action.kids()
  seq.step()
  let tf14 = pushItems(c, action.name([concat]), action.read([$cs]))
  if (tf14 != null(Fail)) {
    return null(Datum), tf14
  }
  let tk15 = action.elemsAbove(tm13)
  let tn16 = hull(c, false, tk15)
  let tf17 = action.fromObj(tn16)
  let tn18 = action.struct([Element])
  let tfirst19 = true
  seq.step()
  action.setField([Name], tn18, tf1)
  tfirst19 = cover(tn18, tf1, tfirst19)
  seq.step()
  action.setField([Attrs], tn18, tf12)
  tfirst19 = cover(tn18, tf12, tfirst19)
  seq.step()
  action.setField([Content], tn18, tf17)
  tfirst19 = cover(tn18, tf17, tfirst19)
  made(c, tn18, tfirst19)
  return action.fromObj(tn18), null(Fail)
}

## element predicate
func action(c Act) (Datum, Fail) {
  let ts1, tf1 = text(action.read([$e]))
  if (tf1 != null(Fail)) {
    return null(Datum), tf1
  }
  let ts2, tf2 = text(action.read([$n]))
  if (tf2 != null(Fail)) {
    return null(Datum), tf2
  }
  return val.fromBool(action.textEqual(ts1, ts2)), null(Fail)
}

