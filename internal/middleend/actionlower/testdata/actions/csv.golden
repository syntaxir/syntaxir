## main action
func action(c Act) (Datum, Fail) {
  let tv1, tf1 = member(c, 3, action.read([$rs]), action.name([Value]), action.field([Value of Value]))
  if (tf1 != null(Fail)) {
    return null(Datum), tf1
  }
  let tn2 = action.struct([File])
  let tfirst3 = true
  action.setField([Records], tn2, tv1)
  tfirst3 = cover(tn2, tv1, tfirst3)
  made(c, tn2, tfirst3)
  return action.fromObj(tn2), null(Fail)
}

## record action
func action(c Act) (Datum, Fail) {
  let tm1 = action.kids()
  let tf2 = push(c, action.name([list]), action.read([$first]))
  if (tf2 != null(Fail)) {
    return null(Datum), tf2
  }
  let ti3, tf3 = items(action.name([map]), action.read([$rest]))
  if (tf3 != null(Fail)) {
    return null(Datum), tf3
  }
  let tj4 = 0
  loop each5 while (tj4 < seq.len(ti3)); post tj4 = (tj4 + 1) {
    let tp6 = itemAt(ti3, tj4, false)
    let tv8, tf8 = member(c, 4, val.unbox(tp6), action.name([$f]), action.field([f of $f]))
    if (tf8 != null(Fail)) {
      return null(Datum), tf8
    }
    let tv7 = tv8
    let tf9 = push(c, action.name([map]), tv7)
    if (tf9 != null(Fail)) {
      return null(Datum), tf9
    }
  }
  let tk10 = action.elemsAbove(tm1)
  let tn11 = hull(c, false, tk10)
  let tf12 = action.fromObj(tn11)
  let tn13 = action.struct([Record])
  let tfirst14 = true
  action.setField([Fields], tn13, tf12)
  tfirst14 = cover(tn13, tf12, tfirst14)
  made(c, tn13, tfirst14)
  return action.fromObj(tn13), null(Fail)
}

