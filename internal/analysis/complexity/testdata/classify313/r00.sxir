@start
rule s = (l / "+{" / "}")* $$
rule l = l (l "q" / ("+{" "+{" z / l !"x" / "{" w) "+{" / (z* "a" / l "ab" &"b" / w "+{")? w)? (z / k "b" &"b" ("" "+{" z* / l z* !"x" !"x" / z* "a" "+")?) / ((l "" "+{" z / k k "b") (z? z* / "+" z z* / "+{" k) / ("q" / l "ab" "+{") "" "a" / (k / l z? k) &"b" ("+" "{" "" / k / !"x" "ab" "b")?) (z? ("ab" "ab" "b" / &"b" "{" / l "q") k / "+")
rule k = "a"
rule w = z?
rule z = "b" "+" "{" [ab+{]* "}" "!"
