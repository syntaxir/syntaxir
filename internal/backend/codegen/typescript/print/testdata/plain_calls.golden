=== limits
// item, called as by invokePlain
function r2(p: Parser): R {
  p.units++;
  if (p.units > p.unitsCheck) {
    p.pollUnits();
  }
  const start = p.pos;
  const rec = p.recovered.length;
  {
    const trail = p.trail.length;
    const prevEnv = p.env;
    const prevCut = p.cut;
    p.cut = false;
    if (++p.depth > p.maxDepth) {
      p.tooDeep();
    }
    let v = e6(p);
    p.depth--;
    p.cut = prevCut;
    p.trail.length = trail;
    if (v !== undefined) {
      v = p.finish(R2, emptyFrame, v, start);
    } else {
      p.pos = start;
      p.recovered.length = rec;
    }
    p.env = prevEnv;
    return v;
  }
}

// word, called as by invokePlain
function r3(p: Parser): R {
