{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SyntaxIR",
  "scopeName": "source.sxir",
  "fileTypes": [
    "sxir"
  ],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#package"
    },
    {
      "include": "#type-definition"
    },
    {
      "include": "#var-definition"
    },
    {
      "include": "#rule-definition"
    },
    {
      "include": "#body"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.sxir",
          "patterns": [
            {
              "include": "#comment-block"
            }
          ]
        },
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.sxir"
        }
      ]
    },
    "package": {
      "match": "(?:^|(?<=;))[ \\t]*(package)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.other.package.sxir"
        },
        "2": {
          "name": "entity.name.namespace.sxir"
        }
      }
    },
    "type-definition": {
      "patterns": [
        {
          "comment": "type Name = { Field Type; ... }",
          "begin": "(?:^|(?<=;))[ \\t]*(type)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)[ \\t]*(=)[ \\t]*(\\{)",
          "beginCaptures": {
            "1": {
              "name": "storage.type.sxir"
            },
            "2": {
              "name": "entity.name.type.sxir"
            },
            "3": {
              "name": "keyword.operator.assignment.sxir"
            },
            "4": {
              "name": "punctuation.definition.block.begin.sxir"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.block.end.sxir"
            }
          },
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "include": "#field"
            },
            {
              "include": "#type-expression"
            },
            {
              "match": ",",
              "name": "punctuation.separator.comma.sxir"
            }
          ]
        },
        {
          "comment": "type Name ~ Type, an alias; only its own parenthesized type permits continuation.",
          "begin": "(?:^|(?<=;))[ \\t]*(type)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)[ \\t]*(~)",
          "beginCaptures": {
            "1": {
              "name": "storage.type.sxir"
            },
            "2": {
              "name": "entity.name.type.sxir"
            },
            "3": {
              "name": "keyword.operator.alias.sxir"
            }
          },
          "patterns": [
            {
              "include": "#type-expression"
            }
          ],
          "end": "(?=;)|$"
        },
        {
          "comment": "A type definition being written",
          "match": "(?:^|(?<=;))[ \\t]*(type)\\b(?:[ \\t]+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": {
              "name": "storage.type.sxir"
            },
            "2": {
              "name": "entity.name.type.sxir"
            }
          }
        }
      ]
    },
    "field": {
      "comment": "The name of a struct field: the first identifier on a line, or after {, ; or ,",
      "match": "(?:^|(?<=[{,;]))\\s*([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "variable.other.property.sxir"
        }
      }
    },
    "type-expression": {
      "patterns": [
        {
          "include": "#type-parenthesized"
        },
        {
          "include": "#type-arguments"
        },
        {
          "include": "#type-struct"
        },
        {
          "include": "#comment"
        },
        {
          "comment": "the bottom and top types",
          "match": "_\\|_|\\b_(?![A-Za-z0-9_])",
          "name": "support.type.builtin.sxir"
        },
        {
          "match": "\\b(int|string|bool|node|error|missing)\\b",
          "name": "support.type.builtin.sxir"
        },
        {
          "match": "[A-Za-z_][A-Za-z0-9_]*",
          "name": "entity.name.type.sxir"
        },
        {
          "match": "\\[\\]|\\*",
          "name": "keyword.operator.type.sxir"
        },
        {
          "match": "\\|",
          "name": "keyword.operator.join.sxir"
        },
        {
          "match": "&",
          "name": "keyword.operator.meet.sxir"
        },
        {
          "match": "[()]",
          "name": "punctuation.parenthesis.sxir"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.sxir"
        }
      ]
    },
    "var-definition": {
      "patterns": [
        {
          "comment": "var name Type = value; the type and the value are optional",
          "begin": "(?:^|(?<=;))[ \\t]*(var)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)",
          "beginCaptures": {
            "1": {
              "name": "storage.type.sxir"
            },
            "2": {
              "name": "variable.other.sxir"
            }
          },
          "end": "(=)|(?=;)|$",
          "endCaptures": {
            "1": {
              "name": "keyword.operator.assignment.sxir"
            }
          },
          "patterns": [
            {
              "include": "#type-expression"
            }
          ]
        },
        {
          "comment": "A variable declaration being written",
          "match": "(?:^|(?<=;))[ \\t]*(var)\\b",
          "captures": {
            "1": {
              "name": "storage.type.sxir"
            }
          }
        }
      ]
    },
    "rule-definition": {
      "patterns": [
        {
          "comment": "rule name Type =, with an optional type",
          "begin": "(?:^|(?<=;))[ \\t]*(rule)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)",
          "beginCaptures": {
            "1": {
              "name": "storage.type.function.sxir"
            },
            "2": {
              "name": "entity.name.function.sxir"
            }
          },
          "end": "(=)|(?=;)|$",
          "endCaptures": {
            "1": {
              "name": "keyword.operator.assignment.sxir"
            }
          },
          "patterns": [
            {
              "include": "#type-expression"
            }
          ]
        },
        {
          "match": "(?:^|(?<=;))[ \\t]*(rule)\\b",
          "captures": {
            "1": {
              "name": "storage.type.function.sxir"
            }
          }
        }
      ]
    },
    "body": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#char-class"
        },
        {
          "include": "#operators-rule"
        },
        {
          "include": "#value-action"
        },
        {
          "include": "#level-call"
        },
        {
          "include": "#peg-group"
        },
        {
          "include": "#predicate"
        },
        {
          "include": "#attribute"
        },
        {
          "include": "#constructor"
        },
        {
          "include": "#builtin-function"
        },
        {
          "include": "#capture-label"
        },
        {
          "include": "#capture-reference"
        },
        {
          "include": "#member"
        },
        {
          "include": "#number"
        },
        {
          "include": "#operator"
        }
      ]
    },
    "string": {
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.sxir"
        }
      },
      "end": "(\")|$",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.sxir"
        }
      },
      "name": "string.quoted.double.sxir",
      "patterns": [
        {
          "include": "#escape"
        }
      ]
    },
    "escape": {
      "patterns": [
        {
          "match": "\\\\(?:u\\{[0-9A-Fa-f]+\\}|u[0-9A-Fa-f]{4}|[ntrfvab0]|[^A-Za-z0-9])",
          "name": "constant.character.escape.sxir"
        },
        {
          "match": "\\\\.",
          "name": "invalid.illegal.escape.sxir"
        }
      ]
    },
    "char-class": {
      "comment": "[a-z_], [^a-z]",
      "begin": "(\\[(?!\\]))(\\^)?",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.character-class.begin.sxir"
        },
        "2": {
          "name": "keyword.operator.negation.sxir"
        }
      },
      "end": "(\\])|$",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.character-class.end.sxir"
        }
      },
      "name": "string.regexp.character-class.sxir",
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "match": "(?<!\\[|\\[\\^)-(?!\\])",
          "name": "keyword.operator.range.sxir"
        }
      ]
    },
    "attribute": {
      "patterns": [
        {
          "comment": "#cut, the cut pragma",
          "match": "#cut(?![A-Za-z0-9_])",
          "name": "keyword.control.cut.sxir"
        },
        {
          "comment": "@attribute(args) or #pragma(args)",
          "begin": "([@#])([A-Za-z_][A-Za-z0-9_]*)(\\()",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.attribute.sxir"
            },
            "2": {
              "name": "entity.other.attribute-name.sxir"
            },
            "3": {
              "name": "punctuation.parenthesis.begin.sxir"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.parenthesis.end.sxir"
            }
          },
          "patterns": [
            {
              "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(=)(?!=)",
              "captures": {
                "1": {
                  "name": "variable.parameter.attribute.sxir"
                },
                "2": {
                  "name": "keyword.operator.assignment.sxir"
                }
              }
            },
            {
              "include": "#parenthesized"
            },
            {
              "include": "#body"
            }
          ]
        },
        {
          "match": "([@#])([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.attribute.sxir"
            },
            "2": {
              "name": "entity.other.attribute-name.sxir"
            }
          },
          "comment": ""
        }
      ]
    },
    "parenthesized": {
      "comment": "A group inside attribute arguments, so that its ) does not end them",
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "include": "#parenthesized"
        },
        {
          "include": "#body"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "match": "\\b(true|false|nil)\\b",
          "name": "constant.language.sxir"
        }
      ]
    },
    "builtin-function": {
      "match": "\\b(len|text|foldl|foldr|map|list|concat)(?=\\()",
      "name": "support.function.builtin.sxir"
    },
    "capture-label": {
      "comment": "label:expr and constructor fields Type{Field: value}",
      "match": "([A-Za-z_][A-Za-z0-9_]*)(:)(?![=])",
      "captures": {
        "1": {
          "name": "variable.other.capture.sxir"
        },
        "2": {
          "name": "punctuation.separator.capture.sxir"
        }
      }
    },
    "capture-reference": {
      "patterns": [
        {
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*",
          "name": "variable.parameter.capture.sxir"
        },
        {
          "match": "\\$[0-9]+",
          "name": "invalid.deprecated.positional-capture.sxir"
        }
      ]
    },
    "member": {
      "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.sxir"
        },
        "2": {
          "name": "variable.other.property.sxir"
        }
      }
    },
    "number": {
      "match": "\\b[0-9]+\\b",
      "name": "constant.numeric.integer.sxir"
    },
    "operator": {
      "patterns": [
        {
          "match": "\\.\\.\\.",
          "name": "constant.language.default-action.sxir"
        },
        {
          "match": "=>",
          "name": "keyword.operator.arrow.sxir"
        },
        {
          "match": ":=",
          "name": "keyword.operator.assignment.sxir"
        },
        {
          "match": "_\\|_",
          "name": "constant.language.bottom.sxir"
        },
        {
          "match": "\\^\\^|\\$\\$|\\^|\\$",
          "name": "keyword.operator.anchor.sxir"
        },
        {
          "match": "(?<![A-Za-z0-9_])_(?![A-Za-z0-9_])",
          "name": "constant.language.top.sxir"
        },
        {
          "match": "==|!=|<=|>=|&&|\\|\\||<|>|%",
          "name": "keyword.operator.sxir"
        },
        {
          "match": "[*+?]",
          "name": "keyword.operator.quantifier.sxir"
        },
        {
          "match": "/",
          "name": "keyword.operator.choice.sxir"
        },
        {
          "match": "[&!]",
          "name": "keyword.operator.lookahead.sxir"
        },
        {
          "match": "-",
          "name": "keyword.operator.discard.sxir"
        },
        {
          "match": "\\.",
          "name": "constant.language.any.sxir"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.sxir"
        },
        {
          "match": "[{}()\\[\\],;]",
          "name": "punctuation.sxir"
        }
      ]
    },
    "comment-block": {
      "begin": "/\\*",
      "end": "\\*/",
      "name": "comment.block.sxir",
      "patterns": [
        {
          "include": "#comment-block"
        }
      ]
    },
    "constructor": {
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\{)",
      "name": "entity.name.type.sxir"
    },
    "predicate": {
      "begin": "\\{",
      "end": "\\}",
      "name": "meta.predicate-action.sxir",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.predicate.begin.sxir"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.predicate.end.sxir"
        }
      },
      "patterns": [
        {
          "include": "#value"
        }
      ]
    },
    "type-struct": {
      "comment": "an unnamed struct type: { A T; B U }",
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.block.begin.sxir"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.end.sxir"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#field"
        },
        {
          "include": "#type-expression"
        }
      ]
    },
    "type-arguments": {
      "comment": "T[U, ...]: the bracket follows the name directly",
      "begin": "(?<=[A-Za-z0-9_])\\[(?!\\])",
      "beginCaptures": {
        "0": {
          "name": "punctuation.bracket.sxir"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.bracket.sxir"
        }
      },
      "patterns": [
        {
          "include": "#type-expression"
        }
      ]
    },
    "type-parenthesized": {
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "include": "#type-expression"
        }
      ]
    },
    "value": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#value-constructor"
        },
        {
          "include": "#value-cast"
        },
        {
          "include": "#value-parenthesized"
        },
        {
          "include": "#keyword"
        },
        {
          "include": "#builtin-function"
        },
        {
          "include": "#capture-reference"
        },
        {
          "include": "#member"
        },
        {
          "include": "#number"
        },
        {
          "include": "#operator"
        }
      ]
    },
    "value-cast": {
      "comment": "x.(T), a cast to a type",
      "begin": "(\\.)[ \\t]*(\\()",
      "beginCaptures": {
        "1": {
          "name": "punctuation.accessor.sxir"
        }
      },
      "end": "\\)",
      "patterns": [
        {
          "include": "#type-expression"
        }
      ]
    },
    "value-parenthesized": {
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "include": "#value"
        }
      ]
    },
    "value-constructor": {
      "begin": "\\b([A-Za-z_][A-Za-z0-9_]*)[ \\t]*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.type.sxir"
        },
        "2": {
          "name": "punctuation.definition.block.begin.sxir"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.end.sxir"
        }
      },
      "patterns": [
        {
          "include": "#value-field"
        },
        {
          "include": "#value"
        }
      ]
    },
    "value-field": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)[ \\t]*(:)(?!=)",
      "captures": {
        "1": {
          "name": "variable.other.property.sxir"
        },
        "2": {
          "name": "punctuation.separator.key-value.sxir"
        }
      }
    },
    "value-action": {
      "begin": "(=>)",
      "beginCaptures": {
        "1": {
          "name": "keyword.operator.arrow.sxir"
        }
      },
      "end": "(?=[;})])|$",
      "name": "meta.value-action.sxir",
      "patterns": [
        {
          "include": "#value-action-block"
        },
        {
          "include": "#value"
        }
      ]
    },
    "value-action-block": {
      "begin": "\\{",
      "end": "\\}",
      "name": "meta.value-action-block.sxir",
      "patterns": [
        {
          "include": "#value"
        }
      ]
    },
    "peg-group": {
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "include": "#body"
        }
      ]
    },
    "operators-rule": {
      "begin": "(?<==)[ \\t]*(#operators)[ \\t]*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.operators-rule.sxir"
        },
        "2": {
          "name": "punctuation.definition.block.begin.sxir"
        }
      },
      "end": "\\}",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#level-declaration"
        },
        {
          "include": "#operators-header"
        },
        {
          "include": "#body"
        }
      ]
    },
    "level-declaration": {
      "begin": "(?:^|(?<=[;{]))[ \\t]*(level)\\b(?:[ \\t]+([A-Za-z_][A-Za-z0-9_]*))?[ \\t]*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.operators-rule.sxir"
        },
        "2": {
          "name": "entity.name.level.sxir"
        },
        "3": {
          "name": "punctuation.definition.block.begin.sxir"
        }
      },
      "end": "\\}",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#operators-header"
        },
        {
          "include": "#body"
        }
      ]
    },
    "operators-header": {
      "patterns": [
        {
          "match": "(?:^|(?<=[;{]))[ \\t]*(infix)[ \\t]+(left|right|none)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.operators-rule.sxir"
            },
            "2": {
              "name": "keyword.other.associativity.sxir"
            }
          }
        },
        {
          "match": "(?:^|(?<=[;{]))[ \\t]*(skip|operand|level|prefix|postfix|infix)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.operators-rule.sxir"
            }
          }
        }
      ]
    },
    "level-call": {
      "match": "\\b(level)(?=\\()",
      "captures": {
        "1": {
          "name": "keyword.control.operators-rule.sxir"
        }
      }
    }
  }
}
